  "maturity": "commercial",
  "principle": "Follows the published advanced-purification (NEWater-style) train with licensor membrane equipment: secondary effluent passes microfiltration/ultrafiltration (licensor: Suez ZeeWeed / DuPont), then cartridge filtration, then reverse osmosis at high pressure (DuPont FilmTec / Hydranautics elements), then UV disinfection/advanced oxidation and mineralisation. The RO stage rejects salts, organics, pathogens and trace contaminants; UV destroys trace organics and provides a second pathogen barrier; conditioning restores hardness and pH for distribution.",
  "process_steps": [
    {
      "id": "SEC",
      "name": "Secondary effluent feed",
      "equipment": [
        "feed pumps"
      ],
      "to": [
        "MF"
      ],
      "streams": {
        "MF": "filtered feed"
      }
    },
    {
      "id": "MF",
      "name": "Microfiltration / ultrafiltration",
      "equipment": [
        "submerged or pressurised MF/UF (ZeeWeed / DuPont)",
        "backwash and CIP systems"
      ],
      "to": [
        "CARTRIDGE"
      ],
      "streams": {
        "CARTRIDGE": "low-turbidity filtrate"
      }
    },
    {
      "id": "CARTRIDGE",
      "name": "Cartridge security filtration",
      "equipment": [
        "5 um cartridge filters",
        "antiscalant dosing"
      ],
      "to": [
        "RO"
      ],
      "streams": {
        "RO": "RO-ready feed"
      }
    },
    {
      "id": "RO",
      "name": "Reverse osmosis",
      "equipment": [
        "FilmTec / Hydranautics spiral-wound elements in pressure vessels",
        "high-pressure pumps",
        "energy recovery devices"
      ],
      "to": [
        "UV",
        "CONC"
      ],
      "streams": {
        "UV": "permeate",
        "CONC": "rejected concentrate"
      }
    },
    {
      "id": "UV",
      "name": "UV disinfection / advanced oxidation",
      "equipment": [
        "medium-pressure UV reactors"
      ],
      "to": [
        "COND"
      ],
      "streams": {
        "COND": "conditioning"
      }
    },
    {
      "id": "COND",
