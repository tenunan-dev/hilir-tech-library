  "maturity": "commercial",
  "principle": "Dosed chlorine (gas, hypochlorite or on-site electrochlorination) forms hypochlorous acid that inactivates pathogens; a contact basin gives the required CT (concentration x time); where chlorinated organics or aquatic toxicity matter, sulphur-dioxide or bisulphite dechlorination strips residual before discharge.",
  "process_steps": [
    {
      "id": "DOSE",
      "name": "Chlorine dosing",
      "equipment": [
        "hypochlorite or gas dosing skids",
        "on-site electrochlorinators"
      ]
    },
    {
      "id": "CT",
      "name": "Contact basin (CT target)",
      "equipment": [
        "baffled contact tank"
      ],
      "to": [
        "DECHL"
      ],
      "streams": {
        "DECHL": "chlorinated effluent"
      }
    },
    {
      "id": "DECHL",
      "name": "Dechlorination",
      "equipment": [
        "sulphur dioxide or bisulphite dosing",
        "ORP control"
      ],
      "to": [
        "OUT"
      ],
      "streams": {
        "OUT": "dechlorinated effluent"
      }
    },
    {
      "id": "OUT",
      "name": "Discharge or reuse",
      "equipment": [
        "residual monitoring"
      ]
    }
  ],
