    {
      "id": "BAY",
      "name": "Incoming line bays",
      "equipment": [
        "line disconnectors",
        "surge arresters",
        "capacitor voltage transformers"
      ],
      "to": [
        "BUS"
      ],
      "streams": {
        "BUS": "busbar"
      }
    },
    {
      "id": "BUS",
      "name": "Busbars and transfer schemes (AIS or GIS)",
      "equipment": [
        "double busbar",
        "bus coupler and transfer breakers"
      ],
      "to": [
        "TRF",
        "COMP"
      ],
      "streams": {
        "TRF": "transformer bays",
        "COMP": "reactive compensation"
      }
    },
    {
      "id": "TRF",
      "name": "Power transformer banks",
      "equipment": [
        "500/275 kV and 275/132 kV banks",
        "on-load tap changers",
        "Buchholz and protection devices"
      ],
      "to": [
        "PROT"
      ],
      "streams": {
        "PROT": "protection and control"
      }
    },
    {
