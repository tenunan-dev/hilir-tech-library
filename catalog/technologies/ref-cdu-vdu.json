{
  "id": "ref-cdu-vdu",
  "name": "Crude and vacuum distillation with heat integration",
  "aliases": [
    "CDU",
    "VDU",
    "atmospheric distillation",
    "vacuum distillation",
    "crude unit",
    "desalting",
