  "sector": "REF",
  "category": "Distillation",
  "applications": [
    "first separation step in every refinery"
  ],
  "maturity": "commercial",
  "principle": "Crude is desalted, preheated against hot product streams and heated in a fired furnace, then separated by boiling range in an atmospheric column into gas, naphtha, kerosene, diesel and atmospheric residue. The residue would crack and foul at atmospheric pressure, so it is reheated and split again under vacuum into vacuum gas oils and vacuum residue.",
  "process_steps": [
    {
      "id": "DES",
      "name": "Desalting",
      "equipment": [
        "electrostatic desalter",
        "wash water system"
      ]
    },
    {
      "id": "PH",
      "name": "Preheat train",
      "equipment": [
        "crude preheat exchanger network"
      ]
    },
    {
      "id": "F1",
      "name": "Atmospheric heater",
      "equipment": [
        "fired crude heater"
      ]
    },
    {
      "id": "ATM",
      "name": "Atmospheric distillation",
      "equipment": [
        "atmospheric column with side strippers and pumparounds"
      ],
      "to": [
        "PROD",
        "F2"
      ],
      "streams": {
        "PROD": "gas, naphtha, kerosene, diesel",
        "F2": "atmospheric residue"
      }
    },
    {
      "id": "PROD",
      "name": "Light products to treating",
      "equipment": [
        "overhead condensers and accumulator"
      ],
      "to": []
    },
    {
      "id": "F2",
      "name": "Vacuum heater",
      "equipment": [
        "fired vacuum heater (370-425 °C)"
      ],
      "to": [
        "VAC"
      ]
    },
    {
      "id": "VAC",
      "name": "Vacuum distillation",
      "equipment": [
        "vacuum column (0.5-2 psia)",
        "steam ejectors or vacuum pumps"
      ],
      "to": [
        "VGO",
        "VR"
      ],
      "streams": {
        "VGO": "vacuum gas oils",
        "VR": "vacuum residue"
      }
    },
    {
      "id": "VGO",
      "name": "VGO to FCC or hydrocracker",
      "to": []
    },
    {
      "id": "VR",
      "name": "Vacuum residue to coker, resid upgrading or fuel oil",
      "to": []
    }
  ],
