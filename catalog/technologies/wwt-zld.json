  "maturity": "commercial",
  "principle": "Licensor-first (Aquatech published trains): pretreated wastewater passes membrane concentration (RO/HERO), then mechanical vapour-recompression or falling-film evaporators, then spray-dryers or forced-circulation crystallisers; distillate is recycled to process and salts crystallise as a solid product/waste — no liquid discharge. Aquatech published performance: brine concentrated to >250,000 mg/L TDS; distillate <10 mg/L.",
  "process_steps": [
    {
      "id": "PRE",
      "name": "Membrane concentration",
      "equipment": [
        "RO or HERO pretreatment trains"
      ],
      "to": [
        "EVAP"
      ],
      "streams": {
        "EVAP": "pre-concentrated brine"
      }
    },
    {
      "id": "EVAP",
      "name": "Evaporation (MVR/falling film)",
      "equipment": [
        "mechanical vapour recompression evaporators"
      ],
      "to": [
        "CRYST"
      ],
      "streams": {
        "CRYST": "further concentrated liquor"
      }
    },
    {
      "id": "CRYST",
      "name": "Crystallisation",
      "equipment": [
        "forced-circulation crystallisers or spray dryers"
      ],
      "to": [
        "SALT",
        "DIST"
      ],
      "streams": {
        "SALT": "salt solids",
        "DIST": "distillate"
      }
    },
    {
