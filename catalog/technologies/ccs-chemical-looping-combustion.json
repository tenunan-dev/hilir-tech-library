        "VENT"
      ],
      "streams": {
        "FR": "oxidised carrier",
        "VENT": "depleted air"
      }
    },
    {
      "id": "VENT",
      "name": "Depleted air to stack",
      "to": []
    },
    {
      "id": "FR",
      "name": "Fuel reactor (fuel oxidised by carrier)",
      "equipment": [
        "fluidised bed fuel reactor"
      ],
      "to": [
        "AR",
        "CON"
      ],
      "streams": {
        "AR": "reduced carrier",
        "CON": "CO2 + H2O"
      }
    },
    {
      "id": "CON",
      "name": "Water condensation and CO2 compression",
      "equipment": [
        "condenser",
