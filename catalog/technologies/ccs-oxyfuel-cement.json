      "status": "planned as of March 2018",
      "year": 2018,
      "source": {
        "url": "https://www.heidelbergmaterials.com/en/ecra-oxyfuel",
        "note": "Heidelberg Materials page, 15 Mar 2018"
      }
    }
  ],
  "advantages": [
    "Concentrated CO2 without a solvent",
    "Can be combined with other capture routes"
  ],
