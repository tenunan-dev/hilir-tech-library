  "maturity": "demonstration",
  "principle": "The kiln burns fuel in oxygen instead of air, and part of the exhaust is recirculated to control temperature. Without nitrogen, the exhaust is 70% CO2 or more, so it only needs purification and compression rather than a separation process.",
  "process_steps": [
    {
      "id": "ASU",
      "name": "Oxygen production",
      "equipment": [
        "air separation unit"
      ],
      "to": [
        "KILN"
      ]
    },
    {
      "id": "KILN",
      "name": "Kiln and calciner firing in O2 with flue gas recirculation",
      "equipment": [
        "kiln burner",
        "recirculation fan and ducts"
      ],
      "to": [
        "CPU"
      ],
      "streams": {
        "CPU": "CO2-rich exhaust (70%+)"
      }
    },
    {
      "id": "CPU",
      "name": "CO2 purification",
      "equipment": [
        "dust removal",
        "drying",
        "CO2 purification unit (inerts removal)"
      ],
      "to": [
        "COMP"
      ]
    },
    {
      "id": "COMP",
      "name": "CO2 compression",
      "equipment": [
        "CO2 compressor"
      ],
      "to": []
    }
  ],
  "key_equipment": [
    "air separation unit",
    "flue gas recirculation fan",
    "modified burners and seals",
    "CO2 purification unit",
    "CO2 compressor"
  ],
  "suppliers": [
    {
      "name": "European Cement Research Academy (ECRA) with Heidelberg Materials and Holcim",
