  "maturity": "commercial",
  "principle": "A fill-and-draw activated sludge variant: all treatment phases run sequentially in one basin per cycle (fill, react, settle, decant, idle), eliminating secondary clarifiers and RAS pumping; licensor equipment (Aqua-Aerobic decanters, Veolia configurations) supplies the decanter and cycle control.",
  "process_steps": [
    {
      "id": "FILL",
      "name": "Fill (static, mixed or aerated)",
      "equipment": [
        "influent valves",
        "mixers and aerators"
      ]
    },
    {
      "id": "REACT",
      "name": "React (aerated and anoxic phases)",
      "equipment": [
        "fine-bubble aeration",
        "mixers"
      ],
      "to": [
        "SETTLE"
      ],
      "streams": {
        "SETTLE": "reacted liquor"
      }
    },
    {
      "id": "SETTLE",
      "name": "Settle (quiescent)",
      "equipment": [
        "no equipment active"
      ]
    },
    {
      "id": "DECANT",
      "name": "Decant treated effluent",
      "equipment": [
        "decanter weirs"
      ],
      "to": [
        "IDLE"
      ],
      "streams": {
        "IDLE": "effluent out"
      }
    },
    {
      "id": "IDLE",
      "name": "Idle and sludge wasting",
      "equipment": [
        "WAS pumps"
      ]
    }
  ],
  "key_equipment": [
