  "maturity": "commercial",
  "principle": "Oil and hydrogen are heated and passed over fixed beds of CoMo or NiMo catalyst, where sulfur, nitrogen and oxygen are converted to H2S, ammonia and water and olefins and aromatics are partly saturated. Separators and an amine scrubber clean and recycle the hydrogen, and a stripper removes H2S and light ends from the product. Topsoe states ULSD below 10 wt ppm sulfur.",
  "process_steps": [
    {
      "id": "FD",
      "name": "Feed and hydrogen mixing",
      "equipment": [
        "feed pump",
        "make-up hydrogen compressor",
        "feed/effluent exchangers"
      ]
    },
    {
      "id": "HTR",
      "name": "Charge heater",
      "equipment": [
        "fired heater"
      ]
    },
    {
      "id": "RX",
      "name": "Hydrotreating reactors",
      "equipment": [
        "fixed-bed reactors with CoMo/NiMo catalyst",
        "quench and distributor trays"
      ]
    },
    {
      "id": "SEP",
      "name": "High-pressure separation",
      "equipment": [
        "HP separator",
        "wash water injection"
      ],
      "to": [
        "SCR",
        "STR"
      ],
      "streams": {
        "SCR": "recycle gas",
        "STR": "liquid"
      }
    },
    {
      "id": "SCR",
      "name": "Recycle gas treating",
      "equipment": [
        "amine scrubber",
        "recycle gas compressor"
      ],
      "to": [
        "FD"
      ]
    },
    {
      "id": "STR",
      "name": "Product stripping",
      "equipment": [
        "stripper column",
        "product dryer"
      ],
      "to": []
    }
  ],
