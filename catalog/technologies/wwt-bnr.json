  "maturity": "commercial",
  "principle": "Standard published configurations (A2/O, UCT, Bardenpho): anaerobic/anoxic/aerobic zone sequencing lets phosphate-accumulating organisms release and luxury-uptake phosphorus and denitrifiers reduce nitrate with influent carbon; internal mixed-liquor recirculation returns nitrified liquor to the anoxic zone. Commodity process knowledge.",
  "process_steps": [
    {
      "id": "ANA",
      "name": "Anaerobic zone (P release)",
      "equipment": [
        "mixers"
      ]
    },
    {
      "id": "ANOX",
      "name": "Anoxic denitrification",
      "equipment": [
        "mixers",
        "internal mixed-liquor recycle pumps"
      ],
      "to": [
        "AER"
      ],
      "streams": {
        "AER": "denitrified liquor"
      }
    },
    {
      "id": "AER",
      "name": "Aerobic zone (nitrification and P uptake)",
      "equipment": [
        "fine-bubble aeration"
      ],
      "to": [
        "SEC"
      ],
      "streams": {
        "SEC": "nutrient-removed liquor"
      }
    },
    {
      "id": "SEC",
      "name": "Secondary clarification",
      "equipment": [
        "clarifier"
      ],
      "to": [
        "RAS"
      ],
      "streams": {
        "RAS": "PAO-rich sludge"
      }
    },
    {
      "id": "RAS",
      "name": "RAS and WAS",
      "equipment": [
        "RAS pumps"
      ]
    }
  ],
  "key_equipment": [
    "zone partitioning",
    "internal recirculation pumps",
    "aeration system"
  ],
