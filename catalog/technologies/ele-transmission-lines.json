      "name": "Route selection and clearance study",
      "equipment": [
        "survey, environmental assessment, PLS-CADD modelling"
      ]
    },
    {
      "id": "TOWER",
      "name": "Foundation and tower erection",
      "equipment": [
        "lattice steel towers or monopoles",
        "insulators (glass, porcelain, composite)"
      ]
    },
    {
      "id": "STRING",
      "name": "Conductor stringing",
      "equipment": [
        "ACSR or AAAC conductors",
        "OPGW earth wire",
        "tension stringing rigs"
      ],
      "to": [
