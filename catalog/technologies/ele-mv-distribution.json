  "maturity": "commercial",
  "principle": "Malaysia's MV distribution levels: TNB supplies 11 kV for roughly 1,000-5,000 kVA and 33 kV up to about 25,000 kVA (22 kV appears in parts of Johor and Perak). At site level an intake substation receives the supply and ring-main units feed substation transformers, often with redundant transformers and an N+1 scheme for critical process loads. MV installations carry the highest periodic-inspection frequency under the Electricity Regulations.",
  "process_steps": [
    {
      "id": "INTAKE",
      "name": "TNB 11 kV or 33 kV supply point",
      "equipment": [
        "ring main unit (RMU) or received section",
        "TNB metering cubicle"
      ],
      "to": [
        "PHASE"
      ],
      "streams": {
        "PHASE": "nominal 11 kV or 33 kV"
      }
    },
    {
      "id": "PHASE",
      "name": "Main MV switchgear",
      "equipment": [
        "vacuum circuit breakers",
        "busbar 630-2500 A",
        "current transformers and protection relays"
      ],
      "to": [
        "TF",
        "FR"
      ],
      "streams": {
        "TF": "transformer feeders",
        "FR": "outgoing site feeders"
      }
    },
    {
      "id": "TF",
      "name": "Distribution transformers",
      "equipment": [
        "11 kV/415 V or 33 kV/415 V transformers (1000-2500 kVA)"
      ],
      "to": [
        "LV"
      ],
      "streams": {
        "LV": "415 V to the LV boards"
      }
    },
    {
      "id": "FR",
      "name": "Feeder route",
      "equipment": [
        "MV cables or overhead lines"
      ],
      "to": [
        "SUB"
      ],
      "streams": {
        "SUB": "remote substations"
      }
    },
    {
      "id": "SUB",
      "name": "Site substations",
      "equipment": [
        "package substations with RMU-fed transformers"
      ]
    },
    {
      "id": "LV",
      "name": "Low-voltage distribution boards",
      "equipment": [
        "see the low-voltage distribution card"
      ]
    }
  ],
