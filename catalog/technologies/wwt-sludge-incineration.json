    "urban plants with no land for biosolids",
    "phosphorus-bearing ash recovery (mono-incineration)"
  ],
  "maturity": "commercial",
  "principle": "Published practice: dewatered sludge is fired in fluidised-bed or multiple-hearth furnaces (self-sustaining above ~28% DS with heat recovery to steam/hot flue gas); flue gas cleaning (SNCR, fabric filters, wet scrubbers) meets EU IED; mono-ash retains phosphorus for recovery (e.g. EasyMining Ash2Product); co-incineration routes sludge to cement kilns or coal plants.",
  "process_steps": [
    {
      "id": "FEED",
      "name": "Dewatered sludge feed",
      "equipment": [
        "piston pumps or belt feeders"
      ],
      "to": [
        "FBC"
      ],
      "streams": {
        "FBC": "sludge fuel"
      }
    },
    {
      "id": "FBC",
      "name": "Fluidised-bed incineration",
      "equipment": [
        "fluidised-bed furnace (850+ C)",
        "sand bed"
      ],
      "to": [
        "FGT"
      ],
      "streams": {
        "FGT": "hot flue gas"
      }
    },
    {
      "id": "FGT",
      "name": "Flue gas treatment",
      "equipment": [
        "SNCR, fabric filter, wet scrubber stages"
      ],
      "to": [
        "STACK"
      ],
      "streams": {
        "STACK": "clean gas"
      }
    },
    {
      "id": "STACK",
      "name": "Stack and monitoring",
      "equipment": [
        "CEMS"
      ]
    },
    {
      "id": "ASH",
      "name": "Ash handling and P recovery (option)",
      "equipment": [
        "ash silos",
        "Ash2Product-type recovery"
      ]
    }
  ],
  "key_equipment": [
    "fluidised-bed furnace",
    "flue gas treatment",
    "ash handling"
  ],
