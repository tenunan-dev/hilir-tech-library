{
  "id": "wwt-sludge-incineration",
  "name": "Sludge incineration and co-incineration",
  "aliases": [
    "sludge mono-incineration",
    "fluidised bed incineration"
  ],
  "sector": "WWT",
  "category": "Sludge and biogas",
