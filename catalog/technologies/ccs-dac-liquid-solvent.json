  "principle": "Fans push air through large contactors wetted with potassium hydroxide, which absorbs CO2 as carbonate. Calcium hydroxide in a pellet reactor transfers the carbonate to calcium carbonate pellets, which are calcined at about 900 °C in an oxygen-fired furnace to release concentrated CO2. The lime is slaked and returned to the loop.",
  "process_steps": [
    {
      "id": "AC",
      "name": "Air contactor (KOH solution)",
      "equipment": [
        "cross-flow contactor with packing",
        "fans",
        "solution pumps"
      ],
      "to": [
        "PR"
      ],
      "streams": {
        "PR": "K2CO3 solution"
      }
    },
    {
      "id": "PR",
      "name": "Pellet reactor",
      "equipment": [
        "fluidised bed pellet reactor"
      ],
      "to": [
        "CALC",
        "AC"
      ],
      "streams": {
        "CALC": "CaCO3 pellets",
        "AC": "regenerated KOH"
      }
    },
    {
      "id": "CALC",
      "name": "Oxy-fired calciner (about 900 °C)",
      "equipment": [
        "circulating fluidised bed calciner",
        "air separation unit"
      ],
      "to": [
        "SL",
        "COMP"
      ],
      "streams": {
        "SL": "CaO",
        "COMP": "CO2"
      }
    },
    {
      "id": "SL",
      "name": "Steam slaker",
      "equipment": [
        "fluidised steam slaker"
      ],
      "to": [
        "PR"
      ],
      "streams": {
        "PR": "Ca(OH)2"
      }
    },
    {
      "id": "COMP",
      "name": "CO2 compression to 15 MPa",
      "equipment": [
        "four-stage CO2 compressor"
      ],
      "to": []
    }
  ],
