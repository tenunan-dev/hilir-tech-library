  "maturity": "commercial",
  "principle": "Mass-exchange pinch analysis treats water as a network resource: each use has a limiting contaminant concentration, so streams can be cascaded from the cleanest duty to the dirtiest before treatment. Targeting gives the minimum fresh-water and wastewater flows, and a regenerator (DAF, membrane, ion exchange) placed at the pinch relaxes the constraint, cutting both intake and downstream ZLD load.",
  "process_steps": [
    {
      "id": "AUDIT",
      "name": "Water audit and contaminant data",
      "equipment": [
        "stream characterisation (COD, TDS, hardness, oil)"
      ]
    },
    {
      "id": "TARGET",
      "name": "Pinch targeting",
      "equipment": [
        "mass-exchange pinch analysis software"
      ]
    },
    {
      "id": "NET",
      "name": "Water network design",
      "equipment": [
        "cascade reuse network",
        "regenerator placement"
      ],
      "to": [
        "REG"
      ],
      "streams": {
        "REG": "streams needing treatment"
      }
    },
    {
      "id": "REG",
      "name": "Partial regeneration",
      "equipment": [
        "DAF / membrane / ion exchange regenerator"
      ],
      "to": [
        "REUSE"
      ],
      "streams": {
        "REUSE": "regenerated water"
      }
    },
    {
      "id": "REUSE",
      "name": "Reuse and discharge",
      "equipment": [
        "reuse allocation and final effluent"
      ]
    }
  ],
