  "maturity": "demonstration",
  "principle": "Combines anaerobic treatment with membrane solids retention: an anaerobic reactor (CSTR or UASB-style) paired with submerged or sidestream UF/MF membranes holds all biomass and solids, enabling long SRT at short HRT, biogas capture from dilute feeds and a solids-free effluent; licensor equipment follows Kubota/ADI published configurations (submerged flat-plate or hollow-fibre modules under gas scour).",
  "process_steps": [
    {
      "id": "REACT",
      "name": "Anaerobic reactor",
      "equipment": [
        "complete-mix or upflow anaerobic reactor",
        "mixing and heating"
      ],
      "to": [
        "MEM"
      ],
      "streams": {
        "MEM": "digested liquor"
      }
    },
    {
      "id": "MEM",
      "name": "Membrane solids retention",
      "equipment": [
        "submerged UF/MF modules with gas scour",
        "permeate pump"
      ],
      "to": [
        "PERM",
        "RAS"
      ],
      "streams": {
        "PERM": "solids-free permeate",
        "RAS": "retained biomass"
      }
    },
    {
      "id": "PERM",
      "name": "Permeate polishing",
      "equipment": [
        "nutrient or sulphide polishing as needed"
      ]
    },
    {
