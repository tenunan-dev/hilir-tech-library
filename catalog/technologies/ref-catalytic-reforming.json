  "principle": "Hydrotreated heavy naphtha passes over a platinum (or platinum-rhenium) catalyst in a series of reactors with fired heaters between them, because the reactions absorb heat. Naphthenes and paraffins become aromatics and hydrogen. Semi-regenerative units stop every 8 to 18 months to regenerate catalyst; continuous units circulate catalyst through a regenerator.",
  "process_steps": [
    {
      "id": "NHT",
      "name": "Naphtha hydrotreating",
      "equipment": [
        "naphtha hydrotreater"
      ]
    },
    {
      "id": "RX",
      "name": "Reactors with interheaters",
      "equipment": [
        "stacked or side-by-side reactors",
        "charge and interheaters",
        "combined feed exchanger"
      ]
    },
    {
      "id": "REG",
      "name": "Continuous catalyst regeneration (CCR)",
      "equipment": [
        "catalyst lift system",
        "regeneration tower"
      ],
      "to": [
        "RX"
      ]
    },
    {
      "id": "SEP",
      "name": "Separation",
      "equipment": [
        "separator",
        "net gas compressor",
        "recontact drums"
      ],
      "to": [
        "H2",
        "STB"
      ],
      "streams": {
        "H2": "hydrogen-rich gas",
        "STB": "reformate"
      }
    },
    {
      "id": "H2",
      "name": "Hydrogen to refinery users",
      "equipment": [
        "PSA (optional)"
      ],
      "to": []
    },
    {
      "id": "STB",
      "name": "Reformate stabilisation",
      "equipment": [
        "stabiliser column"
      ],
      "to": []
    }
  ],
