  "maturity": "commercial",
  "principle": "Follows the published Veolia/evoqua DAF flow: coagulated water meets 50-70% recycle flow saturated with air at 4-6 bar, released as 30-100 um microbubbles in a contact zone; flocs float and are scraped off as float sludge; clarified water leaves under weirs. Licensor equipment: saturation vessel, injection nozzles, full-surface scraper.",
  "process_steps": [
    {
      "id": "COAG",
      "name": "Coagulation and flocculation",
      "equipment": [
        "coagulant and polymer dosing",
        "flocculation tank"
      ]
    },
    {
      "id": "SAT",
      "name": "Air saturation",
      "equipment": [
        "saturation vessel at 4-6 bar",
        "air compressor"
      ],
      "to": [
        "FLOT"
      ],
      "streams": {
        "FLOT": "recycle with microbubbles"
      }
    },
    {
      "id": "FLOT",
      "name": "Flotation separation",
      "equipment": [
        "DAF contact and separation zones",
        "microbubble injection nozzles",
        "full-surface scraper"
      ],
      "to": [
        "OUT",
        "SLG"
      ],
      "streams": {
        "OUT": "clarified effluent",
        "SLG": "float sludge"
      }
    },
    {
      "id": "OUT",
