  "sector": "REF",
  "category": "Conversion / thermal",
  "applications": [
    "vacuum residue destruction",
    "petroleum coke for fuel or anodes"
  ],
  "maturity": "commercial",
  "principle": "Vacuum residue is heated quickly in a furnace to 480 to 590 °C and sent to a coke drum at about 400 °C and 25 to 30 psig, where it cracks thermally over many hours. Vapours go to a fractionator, and solid coke builds up in the drum. Drums run in pairs on a semi-batch cycle of 28 to 36 hours, with one filling while the other is steamed, cooled and cut out with high-pressure water.",
  "process_steps": [
    {
      "id": "FR",
      "name": "Coker fractionator (feed side)",
      "equipment": [
        "fractionator bottoms surge",
        "heater charge pumps"
      ]
    },
    {
      "id": "HTR",
      "name": "Coker heater",
      "equipment": [
        "fired coker heater (480-590 °C)",
        "steam injection"
      ]
    },
    {
      "id": "DRM",
      "name": "Coke drums",
      "equipment": [
        "paired coke drums (about 400 °C, 25-30 psig)",
        "switch valves"
      ],
      "to": [
        "FRAC",
        "COKE"
      ],
      "streams": {
        "FRAC": "vapours",
        "COKE": "coke"
      }
    },
    {
      "id": "COKE",
      "name": "Coke handling",
      "equipment": [
        "hydraulic decoking system",
        "coke pit or pad",
        "crusher and conveyors"
      ],
      "to": []
    },
    {
      "id": "FRAC",
      "name": "Fractionation and gas plant",
      "equipment": [
        "coker fractionator",
        "wet gas compressor",
        "blowdown system"
      ],
      "to": []
    }
  ],
