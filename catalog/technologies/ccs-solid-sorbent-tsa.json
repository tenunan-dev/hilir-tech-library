      ],
      "to": [
        "DES",
        "VENT"
      ],
      "streams": {
        "DES": "loaded sorbent",
        "VENT": "CO2-lean gas"
      }
    },
    {
      "id": "VENT",
      "name": "Treated gas to stack",
      "to": []
    },
