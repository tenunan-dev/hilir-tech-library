{
  "id": "ccs-cryogenic",
  "name": "Cryogenic carbon capture (desublimation)",
  "aliases": [
    "CCC",
    "cooling and liquefaction",
    "SES cryogenic"
  ],
  "sector": "CCS",
  "category": "Post-combustion / cryogenic",
  "applications": [
    "cement",
    "coal and gas power",
    "industrial flue gas"
  ],
  "maturity": "pilot",
  "trl": {
    "low": 5,
    "high": 5,
    "source": {
      "url": "https://www.sintef.no/globalassets/project/tccs-10/dokumenter/d6/tccs-10-monica-garcia-emerging-technologies.pdf",
      "source_id": "sintef",
      "note": "IEAGHG review of current and emerging CO2 capture technologies, TCCS-10, June 2019, Task 1 TRL tables"
    }
  },
  "principle": "Flue gas is dried and cooled to about -117 °C or colder so that CO2 freezes out (desublimes) and is separated as a solid, then melted and pumped as high-purity liquid CO2. Cold is recovered between the incoming and outgoing streams in multi-stream heat exchangers.",
  "process_steps": [
    {
      "id": "FG",
      "name": "Drying and cooling",
      "equipment": [
        "dryer",
        "multi-stream heat exchanger (5 °C minimum approach)"
      ]
    },
    {
      "id": "DS",
      "name": "CO2 desublimation at about -117 °C",
      "equipment": [
        "desublimating heat exchanger or contact liquid vessel",
        "refrigeration loop"
      ],
      "to": [
        "SEP"
      ]
    },
    {
      "id": "SEP",
      "name": "Solid separation and melting",
      "equipment": [
        "solid-liquid separator",
        "melter"
      ],
      "to": [
        "PUMP",
        "VENT"
      ],
      "streams": {
        "PUMP": "liquid CO2",
        "VENT": "cold CO2-lean gas (cold recovered)"
      }
    },
    {
      "id": "VENT",
      "name": "Cold recovery and stack",
      "equipment": [
        "multi-stream heat exchanger"
      ],
      "to": []
    },
    {
      "id": "PUMP",
      "name": "Liquid CO2 pressurisation",
      "equipment": [
        "cryogenic pump"
      ],
      "to": []
    }
  ],
  "key_equipment": [
    "multi-stream heat exchangers",
    "refrigeration system",
    "desublimation unit",
    "solid separator and melter",
    "liquid CO2 pump"
  ],
