{
  "id": "ele-grid-connection",
  "name": "Grid connection and interconnection studies",
  "aliases": [
    "grid impact study",
    "connection study",
    "grid code compliance"
  ],
  "sector": "ELE",
  "category": "Power generation and distribution",
  "applications": [
    "new generation connections",
    "industrial bulk supply above 25 MVA",
    "renewable and storage integration"
  ],
  "maturity": "commercial",
  "principle": "A connection must satisfy the Malaysian Grid Code, which the Grid System Operator owns and administers. The chain is load-flow, short-circuit and transient-stability modelling of the proposed connection, then compliance checks for voltage limits, fault ride-through and reactive capability, then a connection agreement with TNB and GSO approval before energisation. Industrial loads above about 25,000 kVA take supply at 132 kV or 275 kV, which places them inside grid-code territory.",
  "process_steps": [
    {
      "id": "APP",
      "name": "Connection application and data pack",
      "equipment": [
        "load or generation data",
        "single-line diagram",
        "network model (PSS/E or DIgSILENT)"
      ]
    },
    {
      "id": "STUDY",
      "name": "Grid impact study",
      "equipment": [
        "load-flow",
        "short-circuit",
        "transient-stability simulation"
      ],
      "to": [
        "COMPLY"
      ],
      "streams": {
        "COMPLY": "compliance findings"
      }
    },
    {
      "id": "COMPLY",
      "name": "Grid-code compliance",
      "equipment": [
        "voltage and fault ride-through checks",
        "reactive capability",
        "protection coordination"
      ],
      "to": [
        "AGREE"
      ],
      "streams": {
        "AGREE": "compliance report to GSO"
      }
    },
    {
      "id": "AGREE",
      "name": "Connection agreement and approval",
      "equipment": [
        "TNB connection offer",
        "GSO approval"
      ]
    },
    {
      "id": "COMM",
      "name": "Commissioning and energisation",
      "equipment": [
        "witnessed acceptance tests",
        "protection settings handover"
      ]
    }
  ],
  "key_equipment": [
    "network modelling software",
    "protection coordination tools",
    "commissioning test sets"
  ],
  "suppliers": [
    {
      "name": "Grid System Operator (GSO)",
      "product": "Malaysian grid code administration"
    },
    {
      "name": "Tenaga Nasional Berhad (TNB)",
      "product": "connection offer and network access"
    },
    {
      "name": "Siemens PTI",
      "product": "PSS/E modelling and grid studies"
    }
  ],
