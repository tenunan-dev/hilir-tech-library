  "maturity": "commercial",
  "principle": "Standard published produced-water practice: degassing and desanding, multi-stage induced gas flotation for dispersed oil, hydrocyclones or nut-shell filters for tight oil removal, then polishing to reinjection or discharge standards; bridges the WWT sector to upstream operations.",
  "process_steps": [
    {
      "id": "DEG",
      "name": "Degassing and desanding",
      "equipment": [
        "degasser",
        "desanding hydrocyclone"
      ]
    },
    {
      "id": "IGF",
      "name": "Induced gas flotation",
      "equipment": [
        "IGF cells (3-4 stages) with gas sparging"
      ],
      "to": [
        "POLISH"
      ],
      "streams": {
        "POLISH": "oil-lean water"
      }
    },
    {
      "id": "POLISH",
      "name": "Polishing",
      "equipment": [
        "de-oiling hydrocyclones",
        "nut-shell filter"
      ],
      "to": [
        "REUSE",
        "DISP"
      ],
      "streams": {
        "REUSE": "water for reinjection",
        "DISP": "discharge stream"
      }
    },
    {
      "id": "REUSE",
      "name": "Reinjection or reuse",
      "equipment": [
        "injection pumps"
      ]
    },
    {
      "id": "DISP",
      "name": "Compliant discharge",
      "equipment": [
        "discharge monitoring"
      ]
    }
  ],
  "key_equipment": [
    "IGF cells",
