  "principle": "Published practice (Andritz, HUBER, KOPF): dewatered cake (20-28% DS) is dried with waste heat or steam in belt/drum dryers to 90%+ DS (biosolids pellets); pyrolysis variants heat sludge 400-600 C oxygen-free to biochar and syngas, now scaling as a phosphorus-recovery route; evaporated water condensate returns to the plant head.",
  "process_steps": [
    {
      "id": "FEED",
      "name": "Dewatered cake feed",
      "equipment": [
        "cake pumps and feeders"
      ],
      "to": [
        "DRY"
      ],
      "streams": {
        "DRY": "wet cake"
      }
    },
    {
      "id": "DRY",
      "name": "Thermal drying",
      "equipment": [
        "belt or drum dryer (low-temperature, waste-heat driven)"
      ],
      "to": [
        "PELLET"
      ],
      "streams": {
        "PELLET": "dried granules"
      }
    },
    {
      "id": "PELLET",
      "name": "Pelletising and storage",
      "equipment": [
        "pellet mills, silos"
      ]
    },
    {
      "id": "PYRO",
      "name": "Pyrolysis (variant route)",
      "equipment": [
        "pyrolysis kiln 400-600 C"
      ],
      "to": [
        "CHAR"
      ],
      "streams": {
        "CHAR": "biochar"
      }
    },
    {
      "id": "CHAR",
