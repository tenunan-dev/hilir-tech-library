  "maturity": "commercial",
  "principle": "Follows the Royal HaskoningDHV Nereda licensor flow: one cyclical SBR-style reactor with a granular biomass that settles 3-8x faster than flocculent sludge. Simultaneous nitrification/denitrification and bio-P removal happen inside the dense granules (aerobic shell, anoxic/anaerobic core). The published Nereda cycle is: (1) feed/draw from the bottom while decanted clear water leaves the top, (2) aeration/reaction with simultaneous fill, (3) settling of the fast-settling granules, (4) decant of treated effluent; excess sludge is wasted as well-settling granules that dewater easily.",
  "process_steps": [
    {
      "id": "FILL",
      "name": "Feed and simultaneous reaction",
      "equipment": [
        "Nereda reactor with granular biomass",
        "coarse and fine bubble aeration"
      ],
      "to": [
        "SETTLE"
      ],
      "streams": {
        "SETTLE": "reacted mixed liquor"
      }
    },
    {
      "id": "SETTLE",
      "name": "Granule settling (minutes, not half-hours)",
      "equipment": [
        "quiescent settling phase"
      ],
      "to": [
        "DECANT"
      ],
      "streams": {
        "DECANT": "clarified supernatant"
      }
    },
    {
      "id": "DECANT",
      "name": "Treated effluent decant",
      "equipment": [
        "decant weirs"
      ],
      "to": [],
      "streams": {}
    },
    {
      "id": "WASTE",
      "name": "Excess granule wasting",
      "equipment": [
        "granule wasting valve",
        "dewatering (granules dewater readily)"
      ],
      "to": [],
      "streams": {}
    }
  ],
