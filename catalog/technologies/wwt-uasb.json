  "maturity": "commercial",
  "principle": "Follows the Paques BIOPAQ UASB licensor flow: wastewater is fed evenly at the bottom of a tall reactor and flows upward through a dense blanket of anaerobic granular sludge that converts COD to biogas; a three-phase (gas-liquid-solid) separator at the top retains granules, degasses the effluent and discharges treated water. EGSB adds higher upflow velocities and effluent recirculation for dilute streams.",
  "process_steps": [
    {
      "id": "FEED",
      "name": "Bottom influent distribution",
      "equipment": [
        "distribution nozzles"
      ]
    },
    {
      "id": "BLANKET",
      "name": "Granular sludge blanket (COD to biogas)",
      "equipment": [
        "granular anaerobic sludge blanket"
      ],
      "to": [
        "SEP"
      ],
      "streams": {
        "SEP": "liquor with gas"
      }
    },
    {
      "id": "SEP",
      "name": "Three-phase separator",
      "equipment": [
        "gas-liquid-solid separator at reactor top"
      ],
      "to": [
        "OUT",
        "GAS"
      ],
      "streams": {
        "OUT": "treated effluent",
        "GAS": "biogas"
      }
    },
    {
      "id": "OUT",
      "name": "Treated water out",
      "equipment": [
        "degassing and outlet weirs"
      ]
    },
    {
      "id": "GAS",
      "name": "Biogas off-take",
      "equipment": [
        "biogas line to desulphurisation and CHP"
      ]
    }
  ],
