    "thermal hydrolysis AD"
  ],
  "sector": "WWT",
  "category": "Sludge and biogas",
  "applications": [
    "municipal sludge stabilisation",
    "biogas energy recovery at WWTPs",
    "co-digestion with organics"
  ],
  "maturity": "commercial",
  "principle": "Standard published practice: thickened sludge is heated and held 15-25 d (mesophilic, ~35 C) or 8-12 d (thermophilic, ~55 C) in complete-mix digesters where methanogens convert volatile solids to biogas (~60% CH4); optional thermal hydrolysis (Cambi/CNS) pretreatment raises biogas yield and dewaterability; digestate is dewatered and the biogas drives CHP or upgrading.",
  "process_steps": [
    {
      "id": "THICK",
      "name": "Sludge thickening",
      "equipment": [
        "gravity or DAF thickeners"
      ],
      "to": [
        "DH"
      ],
      "streams": {
        "DH": "thickened sludge"
      }
    },
    {
      "id": "DH",
      "name": "Digestion (mesophilic or thermophilic)",
      "equipment": [
        "complete-mix digesters",
        "heat exchangers",
        "gas mixing"
      ],
      "to": [
        "DWS",
        "GAS"
      ],
      "streams": {
        "DWS": "digested sludge",
        "GAS": "biogas"
      }
    },
    {
      "id": "GAS",
      "name": "Biogas use",
      "equipment": [
        "H2S removal",
        "CHP engines or upgrading to biomethane"
      ]
    },
    {
      "id": "DWS",
      "name": "Digestate dewatering",
      "equipment": [
        "centrifuges or belt presses"
      ],
      "to": [
        "CAKE"
      ],
      "streams": {
        "CAKE": "dewatered cake"
      }
    },
    {
      "id": "CAKE",
      "name": "Cake use or disposal",
      "equipment": [
        "land application, drying or landfill"
      ]
    }
  ],
