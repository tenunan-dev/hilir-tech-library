# Frontend container of the split deployment (decision #34): serves the web UI at
# techlib.hilir.app and reads Neon live (DATABASE_URL, read-only role). R1: no embeddings are
# computed here — the SQLite index is built WITHOUT vectors as the offline fallback (R5), and
# fastembed serves only runtime QUERY embedding (model cache warmed below, never a corpus pass).
# Only catalog records and open-licence documents enter the image (agent/export_public.py).
FROM python:3.12-slim AS export
WORKDIR /src
COPY . .
RUN pip install --no-cache-dir pyyaml && python agent/export_public.py /public

FROM python:3.12-slim
WORKDIR /app
COPY --from=export /public .
# The fallback index builds in seconds (no embed step); the fastembed model warms once so
# /search and /database/search embed queries locally with exact parity to the index's model.
RUN pip install --no-cache-dir -r requirements-agent.txt "psycopg[binary]>=3.1" \
 && python agent/library.py build \
 && OMP_NUM_THREADS=4 python -c "import sys; sys.path.insert(0, 'agent'); import embed; from fastembed import TextEmbedding; TextEmbedding(model_name=embed.DEFAULT_MODEL)"
ENV PORT=8000
EXPOSE 8000
# LIBRARY_API_KEY, DATABASE_URL, USER_STORE_URL, LIBRARY_USERS and LIBRARY_API_PUBLIC_URL are
# set at run time by the frontend Worker (a secret, never baked in).
CMD ["python", "agent/server.py", "--http"]
