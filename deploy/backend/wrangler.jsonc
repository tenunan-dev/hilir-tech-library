{
  // Backend Worker of the split deployment (decision #34): MCP + REST at https://techlib-api.hilir.app
  // (owner-confirmed 2026-10-31, P0.3). API-key + OAuth auth only; no web UI here. Deploy from this
  // folder: npx wrangler deploy (needs Docker running; builds ../docker/Dockerfile.backend).
  // /__embed was retired 2026-10-31 (P3.1): both split containers embed queries locally, so the
  // edge service had no callers left; the AI binding went with it.
  "name": "og-tech-library-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "afa8fa65e07832d7e611e831d150d3bd",
  "observability": { "enabled": true },
  // The service a machine (sk-) key must be issued for. Estate convention: audience matches the
  // service, and the Access registry lists this library as "techlib". Keys issued for another
  // service are rejected; keys with no audience are allowed but logged (see src/authz.ts).
  "vars": {
    "AUDIENCE": "techlib",
    // Access: the issuer this Worker verifies against, and the client it
    // authenticates as when introspecting a person's key (RFC 7662). The
    // matching client secret is a wrangler secret: HILIR_CLIENT_SECRET.
    // NOTE: AUDIENCE is the `aud` this Worker requires. The edge advertises the
    // resource as its own origin (RFC 8707), so confirm which value real tokens
    // carry before relying on the JWT path here.
    "HILIR_ISSUER": "https://access.hilir.app/api/auth",
    "HILIR_CLIENT_ID": "afRPzPMPgvTxROtxPODjFLeKCkbKJxEz", // techlib-api (introspection only)
    // Phase 3 (VPS-COMPUTE.md §5.3): the container runs on the VPS behind the
    // tunnel; ORIGIN_TOKEN is the shared origin secret (wrangler secret put).
    "LIBRARY_ORIGIN": "https://techlib-origin.hilir.app"
  },
  // No KV, no Service Binding to Access: since the auth rebuild this Worker
  // verifies tokens itself (jose + Access JWKS) and introspects keys over HTTP
  // (RFC 7662). Both bindings were dead code — the old sk- key checker and the
  // oauth-provider loopback flow they served are gone.
  //
  // Migration history: "v1" created the LibraryApi Durable Object when this
  // Worker supervised a container. The container moved to the VPS behind the
  // tunnel (Phase 3), so the class was removed from src and "v2" deletes the
  // namespace. Cloudflare requires this entry before a script without the class
  // may be published (error 10064).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LibraryApi"] },
    { "tag": "v2", "deleted_classes": ["LibraryApi"] }
  ],
  "routes": [
    { "pattern": "techlib-api.hilir.app", "custom_domain": true }
  ]
}
