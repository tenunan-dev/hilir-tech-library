{
  // REFERENCE ONLY — NOT DEPLOYED (verified live 2026-11-20: the PRM path 404s on
  // techlib.hilir.app with the UI handler's error, so the split pair
  // og-tech-library-ui + og-tech-library-api serves production). This config
  // CLAIMS BOTH custom domains, so a plain `npx wrangler deploy` here would
  // re-point them away from the live workers — the same footgun hilir-access
  // closed in 9754bc2. The `routes` block is therefore removed; if the Phase-4
  // consolidation is ever finished, re-add:
  //   "routes": [
  //     { "pattern": "techlib.hilir.app", "custom_domain": true },
  //     { "pattern": "techlib-api.hilir.app", "custom_domain": true }
  //   ]
  // and swap: deploy (fails on the domains) -> remove the domains from the two
  // live Workers -> redeploy -> verify per docs/AUTH.md.
  //
  // Secrets for that future deploy (wrangler secret put on THIS Worker):
  // ORIGIN_TOKEN, HILIR_CLIENT_SECRET (the UI browser-login client). The
  // retired LIBRARY_API_KEY / INTERNAL_TOKENS / DATABASE_URL / USER_STORE_URL
  // are gone with the pre-rebuild auth — do not recreate them.
  "name": "techlib-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "afa8fa65e07832d7e611e831d150d3bd",
  "observability": { "enabled": true },
  "vars": {
    "API_ORIGIN": "https://techlib-api.hilir.app",
    "LIBRARY_ORIGIN": "https://techlib-origin.hilir.app",
    // Both registered resource origins: the API handler runs on BOTH hostnames
    // under this worker, so tokens minted for either resource must verify
    // (the backend module parses the comma list; a single origin here would
    // 401 every direct MCP client token on the API host).
    "AUDIENCE": "https://techlib.hilir.app,https://techlib-api.hilir.app",
    // Phase 4: the UI handler is an OIDC client of Access.
    "HILIR_ISSUER": "https://access.hilir.app/api/auth",
    "HILIR_CLIENT_ID": "YBUSRWpUyOKWcnrxJPITRYptIBsqtYFL",
    "APP_ORIGIN": "https://techlib.hilir.app",
    "REQUIRED_SCOPE": "catalog:read"
  }
}
