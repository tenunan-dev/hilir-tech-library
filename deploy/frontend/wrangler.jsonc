{
  // Frontend Worker of the split deployment (decision #34): the web UI at https://techlib.hilir.app.
  // Session-cookie auth only (verified inside the container); no public API on this domain except
  // key-held /api/stats and /api/openapi.json. Deploy from this folder: npx wrangler deploy
  // (needs Docker running; builds ../docker/Dockerfile.frontend). Rollback: deploy/cloudflare is
  // the pre-split single-Worker config and stays deployable until Phase 3 completes.
  "name": "og-tech-library-ui",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "afa8fa65e07832d7e611e831d150d3bd",
  "observability": { "enabled": true },
  "vars": {
    // where the UI's footer REST/MCP links point (owner-confirmed backend domain, P0.3)
    "API_ORIGIN": "https://techlib-api.hilir.app",
    // Phase 3 (VPS-COMPUTE.md §5.3): the container runs on the VPS behind the
    // tunnel; ORIGIN_TOKEN is the shared origin secret (wrangler secret put).
    "LIBRARY_ORIGIN": "https://techlib-origin.hilir.app",
    // Phase 4 auth (the UI worker is an OIDC client of hilir Access). These
    // mirror the edge worker's vars; the client secret is a wrangler secret.
    // They MUST stay in this config: a deploy without them wipes the live
    // plain-text vars and every UI path except /health starts 1101-ing
    // (seen 2026-11-07).
    "APP_ORIGIN": "https://techlib.hilir.app",
    "HILIR_ISSUER": "https://access.hilir.app/api/auth",
    "HILIR_CLIENT_ID": "YBUSRWpUyOKWcnrxJPITRYptIBsqtYFL"
  },
  "routes": [
    { "pattern": "techlib.hilir.app", "custom_domain": true }
  ]
}
