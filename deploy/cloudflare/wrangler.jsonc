{
  // Hosted MCP server for the O&G technology library: https://techlibrary.tenunan.com/mcp
  // Deploy from this folder: npx wrangler deploy   (needs Docker running; builds ../../Dockerfile)
  "name": "og-tech-library",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "afa8fa65e07832d7e611e831d150d3bd",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Library",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY", "class_name": "Library" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Library"] }],
  "routes": [{ "pattern": "techlibrary.tenunan.com", "custom_domain": true }]
}
