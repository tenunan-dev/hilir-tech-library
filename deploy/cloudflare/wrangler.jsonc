{
  // RETIRED / ROLLBACK-ONLY config (pre-split single-container worker `og-tech-library`).
  // Since the decision #34 cutover the live workers are deploy/frontend (og-tech-library-ui at
  // techlib.hilir.app) and deploy/backend (og-tech-library-api at techlib-api.hilir.app).
  //
  // This worker owns NO custom domain: Cloudflare workers/domains (checked 2026-11-02) attaches
  // techlib.hilir.app to og-tech-library-ui. The route declaration was removed on 2026-11-02 —
  // exactly one worker may hold a custom domain, so deploying this folder would otherwise try to
  // reclaim it from the UI worker (breaking SSO and the web UI).
  //
  // Full rollback (deliberate, manual): remove the route from deploy/frontend/wrangler.jsonc,
  // re-add `"routes": [{ "pattern": "techlib.hilir.app", "custom_domain": true }]` here, then
  // deploy this folder. Do not deploy this folder without the route: a routeless deploy only
  // updates a worker nothing reaches.
  "name": "og-tech-library",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "afa8fa65e07832d7e611e831d150d3bd",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "36f1ee63335644608a3969baec462626" }],
  "containers": [
    {
      "class_name": "Library",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY", "class_name": "Library" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Library"] }]
}
