{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process drawing record",
  "description": "One citable PFD, P&ID, schematic or flowsheet for a process, technology or equipment class. The diagram itself stays at its publisher's URL; this record says what it shows and where the terms allow it to be used.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "diagram_type", "description", "publisher", "url", "sectors", "sources", "last_reviewed"],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source_id": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "diagram_type": {"enum": ["PFD", "P&ID", "schematic", "flowsheet", "block-diagram"]},
    "description": {"type": "string", "description": "What the diagram shows, in our own words"},
    "publisher": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "licence": {"type": "string"},
    "reuse_level": {"enum": ["full-text-open", "full-text-with-attribution", "full-text-restricted", "summary-only", "catalog-only"]},
    "sectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "regions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "equipment": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "technologies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "gaps": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["what", "why", "next_action"],
      "properties": {"what": {"type": "string"}, "why": {"type": "string"}, "next_action": {"type": "string"}}
    }},
    "notes": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
