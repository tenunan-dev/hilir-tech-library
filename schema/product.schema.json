{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product catalog record",
  "description": "One vendor product line with the specifications printed on the vendor's own catalog or spec sheet. Facts come from pages actually read; anything not found is a recorded gap, never a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "manufacturer", "product_type", "description", "specifications", "url", "sources", "last_reviewed"],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source_id": {"type": "string", "description": "Catalog source id, when the page is catalogued"},
        "note": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": {"type": "string"},
        "unit": {"type": "string"},
        "value": {"type": ["number", "string"]},
        "low": {"type": ["number", "string"]},
        "high": {"type": ["number", "string"]},
        "basis": {"type": "string"},
        "year": {"type": "integer", "description": "Dollar year, required for any USD cost metric"},
        "source": {"$ref": "#/$defs/ref"}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "manufacturer": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Vendor directory id"},
    "product_type": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Equipment type this product belongs to"},
    "equipment": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "description": "Equipment class ids this product supplies"},
    "description": {"type": "string"},
    "specifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spec"}},
    "url": {"type": "string", "format": "uri"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "gaps": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["what", "why", "next_action"],
      "properties": {"what": {"type": "string"}, "why": {"type": "string"}, "next_action": {"type": "string"}}
    }},
    "notes": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
