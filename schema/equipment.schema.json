{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Equipment record",
  "description": "One equipment class in the library's equipment catalog: what it is, its specification ranges with the sources behind them, and the vendors in the directory that supply it. Facts recorded here come from pages the author read or a recorded source; anything not found is a recorded gap, never a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "equipment_type",
    "description",
    "specifications",
    "vendors",
    "sources",
    "last_reviewed"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_id": {
          "type": "string",
          "description": "Catalog record id, when the source is in the catalog"
        },
        "note": {
          "type": "string",
          "description": "Which page was read and when"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "description": "Single value for qualities like emissions or temperature ranges that are stated once",
          "type": [
            "number",
            "string"
          ]
        },
        "low": {
          "type": [
            "number",
            "string"
          ],
          "description": "Bottom of the range; when low is a string it is part of the basis, not a number"
        },
        "high": {
          "type": [
            "number",
            "string"
          ],
          "description": "Top of the range"
        },
        "basis": {
          "type": "string",
          "description": "The observed value(s) as stated, with the qualifier; costs name their dollar year here"
        },
        "year": {
          "type": "integer",
          "description": "Dollar year, required for any USD cost metric"
        },
        "source": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "model_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Vendor id in catalog/vendors/"
        },
        "line": {
          "type": "string",
          "description": "Product family or model series name"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Named models, sizes or series as written on the vendor page"
        },
        "range": {
          "type": "string",
          "description": "The model line's stated capacity/pressure/temperature range as written"
        },
        "note": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names the equipment is listed under on cards or in the register"
    },
    "equipment_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The equipment family this record belongs to, e.g. boiler, compressor, exchanger"
    },
    "sector": {
      "type": "string",
      "enum": [
        "UPS",
        "MID",
        "GAS",
        "REF",
        "PCH",
        "PWR",
        "H2",
        "CCS",
        "PRC",
        "ROT",
        "INS",
        "MAT",
        "HSE",
        "DIG"
      ],
      "description": "Primary taxonomy code this equipment is grouped under for index pages"
    },
    "sector_codes": {
      "type": "array",
      "items": {
        "enum": [
          "UPS",
          "MID",
          "GAS",
          "REF",
          "PCH",
          "PWR",
          "H2",
          "CCS",
          "PRC",
          "ROT",
          "INS",
          "MAT",
          "HSE",
          "DIG"
        ]
      },
      "description": "All codes this equipment serves (sectors and disciplines)"
    },
    "description": {
      "type": "string",
      "description": "One to three sentences in our own words"
    },
    "subtypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where this equipment is used, as stated by the vendor or standard references"
    },
    "specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spec"
      }
    },
    "vendor_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_line"
      },
      "description": "Per-vendor model lines with their stated sizes and ranges"
    },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Vendor ids from catalog/vendors/ that supply this equipment"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Technology card ids in catalog/technologies/ that use this equipment"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why",
          "next_action"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "Where the data lives but was not reachable, or why it is missing"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
