{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material record",
  "description": "One engineering material with the properties printed on a source the author read. Every numeric value carries a basis and a source URL; anything not found is a recorded gap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "material_category", "description", "specifications", "sources", "last_reviewed"],
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source_id": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["metric"],
      "properties": {
        "metric": {"type": "string"},
        "unit": {"type": "string"},
        "value": {"type": ["number", "string"]},
        "low": {"type": ["number", "string"]},
        "high": {"type": ["number", "string"]},
        "basis": {"type": "string"},
        "year": {"type": "integer"},
        "source": {"$ref": "#/$defs/ref"}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "material_category": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "description": {"type": "string"},
    "specifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spec"}},
    "applications": {"type": "array", "items": {"type": "string"}},
    "standards": {"type": "array", "items": {"type": "string"}},
    "equipment": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "suppliers": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "gaps": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["what", "why", "next_action"],
      "properties": {"what": {"type": "string"}, "why": {"type": "string"}, "next_action": {"type": "string"}}
    }},
    "notes": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
