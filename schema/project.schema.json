{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project record",
  "description": "One named project or operating plant in the library: who owns and builds it, what technologies it uses, its capacity and milestones. Facts recorded here come from pages the author read or a recorded source; anything not found is a recorded gap, never a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "status",
    "description",
    "technologies",
    "sources",
    "last_reviewed"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_id": {
          "type": "string",
          "description": "Catalog record id, when the source is in the catalog"
        },
        "note": {
          "type": "string",
          "description": "Which page was read and when"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "description": "e.g. power generation, H2 production, CO2 storage, IT load"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "low": {
          "type": [
            "number",
            "string"
          ]
        },
        "high": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "year"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "low": {
          "type": [
            "number",
            "string"
          ]
        },
        "high": {
          "type": [
            "number",
            "string"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "description": "Dollar year of the figure"
        },
        "source": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "date"
      ],
      "properties": {
        "event": {
          "type": "string",
          "description": "e.g. FID, first concrete, first production, COD"
        },
        "date": {
          "type": "string",
          "description": "As precise as the source states: year, month or ISO date"
        },
        "source": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Company name as written; when it matches a catalog vendor id use vendor_id instead"
        },
        "vendor_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Vendor id in catalog/vendors/, when the party is in the directory"
        },
        "role": {
          "type": "string",
          "description": "e.g. operator, sponsor, EPC, FEED, technology licensor, O&M, offtaker"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names the project is listed under on cards or in sources"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "greenfield",
        "expansion",
        "retrofit",
        "operating-asset"
      ],
      "description": "What kind of undertaking this is"
    },
    "sector": {
      "type": "string",
      "enum": [
        "UPS",
        "MID",
        "GAS",
        "REF",
        "PCH",
        "PWR",
        "H2",
        "CCS",
        "IDC",
        "PRC",
        "ROT",
        "INS",
        "MAT",
        "HSE",
        "DIG",
        "ELE",
        "CIV"
      ],
      "description": "Primary taxonomy code this project is grouped under for index pages"
    },
    "sector_codes": {
      "type": "array",
      "items": {
        "enum": [
          "UPS",
          "MID",
          "GAS",
          "REF",
          "PCH",
          "PWR",
          "H2",
          "CCS",
          "IDC",
          "PRC",
          "ROT",
          "INS",
          "MAT",
          "HSE",
          "DIG",
          "ELE",
          "CIV"
        ]
      },
      "description": "All codes this project touches"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166 alpha-2 code, or a descriptive location for multi-site assets"
    },
    "location": {
      "type": "string",
      "description": "Site name, city, province as stated by the source"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "FID",
        "under-construction",
        "commissioning",
        "operating",
        "suspended",
        "decommissioned"
      ]
    },
    "description": {
      "type": "string",
      "description": "One to three sentences in our own words"
    },
    "capacities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capacity"
      },
      "description": "Rated capacities per metric (power, production, storage, IT load), phases separated"
    },
    "capex": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cost"
      },
      "description": "Announced or reported capital cost figures, each with its dollar year"
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "description": "Owners, sponsors and JV partners"
    },
    "contractors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "description": "EPC, FEED, construction and O&M contractors"
    },
    "offtakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "description": "Offtake and power-purchase counterparties"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Technology card ids in catalog/technologies/ that this project deploys"
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      },
      "description": "Dated milestones, each with its source"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why",
          "next_action"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "description": "Where the data lives but was not reachable, or why it is missing"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
