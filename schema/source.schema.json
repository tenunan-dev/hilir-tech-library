{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tenunan-dev/hilir-tech-library/schema/source.schema.json",
  "title": "Source catalog record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "url",
    "source_type",
    "sectors",
    "disciplines",
    "publisher_org",
    "regions",
    "access",
    "licence",
    "reuse_level",
    "quality_tier",
    "verification",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "source_type": {
      "enum": [
        "standards-body",
        "licensor",
        "oem-supplier",
        "epc-contractor",
        "journal",
        "agency-data",
        "association",
        "conference",
        "patents",
        "trade-media",
        "research-institute"
      ]
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UPS",
          "MID",
          "GAS",
          "REF",
          "PCH",
          "PWR",
          "H2",
          "CCS"
        ]
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRC",
          "ROT",
          "INS",
          "MAT",
          "HSE",
          "DIG"
        ]
      }
    },
    "subtopics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "publisher_org": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$|^INT$"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "global",
          "apac",
          "sea",
          "me",
          "eu",
          "na",
          "latam",
          "af"
        ]
      }
    },
    "access": {
      "enum": [
        "open",
        "free-registration",
        "paywalled",
        "mixed"
      ]
    },
    "licence": {
      "type": "string",
      "description": "SPDX id where possible, else public-domain, proprietary or unknown"
    },
    "reuse_level": {
      "enum": [
        "full-text-open",
        "full-text-restricted",
        "summary-only",
        "catalog-only"
      ],
      "description": "full-text-open: open licence allows reuse. full-text-restricted: downloadable, no open licence, terms do not forbid private reference copies; private repo only, with notes. summary-only: our own summaries and facts. catalog-only: not downloadable or terms forbid copying; keep for future retrieval."
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "update_frequency": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annual",
        "irregular"
      ]
    },
    "content_formats": {
      "type": "array",
      "items": {
        "enum": [
          "html",
          "pdf",
          "dataset",
          "api",
          "video"
        ]
      }
    },
    "quality_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 standards/peer review, 2 agency/licensor/association, 3 marketing/trade media"
    },
    "verification": {
      "enum": [
        "verified",
        "unverified"
      ],
      "description": "verified = URL and licence checked by a person or tool on last_verified"
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "automated_access": {
      "enum": [
        "allowed",
        "prohibited",
        "unstated"
      ],
      "description": "What the site's terms say about robots, crawlers and automated copying. prohibited = manual download only."
    },
    "permitted_use": {
      "enum": [
        "any",
        "internal-organisation",
        "personal-non-commercial",
        "none",
        "unstated"
      ],
      "description": "Widest use the terms allow for downloaded copies. unstated = no terms of use published; default copyright applies."
    }
  }
}
